{
  "name": "@justmytwospence/pi-bg",
  "version": "0.1.0",
  "description": "Background jobs and services for pi: the agent waits on a job inside its turn (so it shows as working), or is woken when it ends; services wake it when ready. A footer status, a /bg viewer, and herdr integration through pi-herdr's event bus.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "background",
    "herdr"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justmytwospence/pi-bg"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@types/node": "^22.20.4",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
